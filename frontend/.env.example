# Vite reads VITE_* variables at build time.
# Copy this file to .env.local for local overrides (never commit .env.local).

# Point to your deployed Django backend
VITE_API_URL=https://your-backend.onrender.com/api

# For local development the default fallback is https://restroapi-vvei.onrender.com/api
# so you don't need to set this variable locally.
